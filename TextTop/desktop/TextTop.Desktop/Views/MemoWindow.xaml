<Window x:Class="TextTop.Desktop.Views.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" MinWidth="220" MinHeight="280"
        Background="#FFFBEA" Closing="Window_Closing">
    <Border Padding="10" Background="#FFFBEA">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#E5D58A"/>
                <CheckBox Grid.Column="1" Content="Top" IsChecked="{Binding IsTopMost}" Margin="8,0" VerticalAlignment="Center" Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                <Button Grid.Column="2" Content="SAVE" Click="SaveButton_Click" Height="30" Padding="12,0" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                <Button Grid.Column="3" Content="+" Command="{Binding NewCommand}" Height="30" Width="32" Margin="6,0,0,0" Background="#111827" Foreground="White" BorderThickness="0"/>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right" Margin="0,6,0,0"/>
            <TextBox x:Name="MemoContentBox"
                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Segoe UI" FontSize="14" Padding="8" BorderBrush="#E5D58A" Background="#FFFEF2"
                     PreviewMouseDown="MemoContentBox_PreviewMouseDown"
                     PreviewTextInput="MemoContentBox_PreviewTextInput"
                     PreviewKeyDown="MemoContentBox_PreviewKeyDown"/>
        </DockPanel>
    </Border>
</Window>
